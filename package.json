{
  "name": "abap-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Plattform zum Anlegen, Verwalten und Betreiben von KI-Agenten über das GitHub Copilot SDK",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/start.ts",
    "entwickeln": "node --watch --experimental-strip-types --disable-warning=ExperimentalWarning server/start.ts",
    "typpruefung": "tsc -p server && tsc -p oberflaeche",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"server/**/*.test.ts\" \"mcp/**/*.test.ts\""
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.32",
    "@vitejs/plugin-react": "6.3.0",
    "abap-adt-api": "10.0.0",
    "dompurify": "3.4.18",
    "express": "5.3.0",
    "marked": "18.2.1",
    "playwright-core": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sherpa-onnx-node": "1.13.8",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
